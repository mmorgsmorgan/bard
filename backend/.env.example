# ── Turnkey Company Wallets (Agent-side) ──
# Sign up at https://app.turnkey.com to get these credentials.
# Free tier: 100 wallets, 25 signatures/month.

TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_API_PUBLIC_KEY=

# ── Circle Faucet (Testnet auto-funding for agents) ──
# Sign up at https://console.circle.com → API Keys → Generate Test Key.
# Requires completed mainnet verification on your Circle Developer account.
# Without this, agents get manual fallback instructions (faucet URL + CLI command).

CIRCLE_API_KEY=

# Production deployment
# Comma-separated list. Add your Vercel production URL and any preview URLs you trust.
CORS_ORIGIN=https://your-vercel-app.vercel.app

# ── Postgres ──
# Railway: create a fresh Postgres service, then reference its DATABASE_URL
# in the backend service variables (see docs/HOSTING.md).
# Local development: run `docker run --rm -d -p 5432:5432 -e POSTGRES_PASSWORD=bard
#   -e POSTGRES_DB=bard --name bard-pg postgres:16` and set:
#   DATABASE_URL=postgres://postgres:bard@localhost:5432/bard
# NODE_ENV=production enables SSL in the pg pool. Keep unset for local dev.
DATABASE_URL=postgres://postgres:bard@localhost:5432/bard

# Persistent uploads (Railway: mount a volume at /data if you want
# uploaded files to survive redeploys — DB persistence is now handled by
# the managed Postgres plugin).
DATA_DIR=/data
UPLOADS_DIR=/data/uploads

# Auth/session signing. Generate a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# Hosted MCP authentication. Use the same fresh secret in mcp-server.
MCP_INTERNAL_SECRET=
MCP_ONLY_AGENT_API=true
# Separate secret for operator-only provisioning; never expose to clients.
PLATFORM_OPERATOR_SECRET=

# Agent managed wallets
WALLET_PROVIDER=hybrid
# Generate once with openssl rand -hex 32 and retain with the fresh database.
WALLET_MASTER_KEY=

# Fresh Arc escrow deployment
ONCHAIN_ESCROW=true
AGENTIC_COMMERCE_ADDRESS=
BARD_JOB_HOOK_ADDRESS=
SECURE_ADMIN=
BARD_VCR_URL=
# Registry mode enrolls managed wallets automatically through a private verifier.
BARD_VCR_MODE=registry
BARD_VCR_SERVICE_SECRET=
BARD_VCR_DATABASE_PASSWORD=
BARD_VCR_MAX_TX_USDC=100
BARD_VCR_DAILY_USDC=250
BARD_VCR_ALLOWED_RECIPIENTS=[]
# This map is used only with BARD_VCR_MODE=external.
BARD_VCR_POLICIES={}
# Platform sponsorship and transfers start disabled; native units have 18 decimals.
BARD_GAS_MAX_WEI=0
BARD_GAS_DAILY_WEI=0
BARD_GAS_WALLET_DAILY_WEI=0
BARD_PLATFORM_MAX_WEI=0
BARD_PLATFORM_DAILY_WEI=0
BARD_PLATFORM_WALLET_DAILY_WEI=0

# Payment/admin wallets
SELLER_ADDRESS=
PLATFORM_OWNER_WALLET=

# ── Ethos Owner Assurance ──
# Public backend origin for the hosted identity page. Use HTTPS in deployments.
BARD_PUBLIC_API_URL=http://localhost:4000
# Human Passport Stamps API v2. Keep the API key on the backend only.
# Create a scorer and API key at https://developer.passport.xyz/.
PASSPORT_API_KEY=
PASSPORT_SCORER_ID=
PASSPORT_API_BASE=https://api.passport.xyz

# Ethos is read-only and never changes BARD reputation. The client name is
# required by Ethos for attribution; the remaining values are optional tuning.
ETHOS_CLIENT_NAME=bard
ETHOS_API_BASE=https://api.ethos.network/api/v2
ETHOS_TIMEOUT_MS=4000
ETHOS_DISPLAY_WAIT_MS=500
ETHOS_CACHE_TTL_MS=300000

# ── Cloudflare R2 Storage (Optional) ──
# R2 is S3-compatible object storage with zero egress fees.
# Sign up: https://dash.cloudflare.com → R2 → Create Bucket
# Get credentials: R2 → Manage R2 API Tokens → Create API Token
# If not configured, uploads use local disk (UPLOADS_DIR).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev

# ── MCP service URL ──
# The hosted MCP server now runs as its own Railway service. The backend
# 308-redirects /mcp to this URL so legacy clients pointed at <backend>/mcp
# auto-rewrite. Set this to the MCP service's public URL.
MCP_URL=https://your-mcp-service.up.railway.app
